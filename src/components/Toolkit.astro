---
// Interactive Compact Toolkit — Astro Component
const skills = [
  { name: "React", icon: "⚛️", color: "hover:border-sky-400 hover:shadow-sky-500/30 hover:text-sky-300 text-sky-400" },
  { name: "Astro", icon: "🚀", color: "hover:border-orange-500 hover:shadow-orange-500/30 hover:text-orange-300 text-orange-400" },
  { name: "Tailwind CSS", icon: "🌊", color: "hover:border-cyan-400 hover:shadow-cyan-400/40 hover:text-cyan-200 text-cyan-300" },
  { name: "Node.js", icon: "🟢", color: "hover:border-emerald-500 hover:shadow-emerald-500/30 hover:text-emerald-300 text-emerald-400" },
  { name: "PostgreSQL", icon: "🐘", color: "hover:border-blue-400 hover:shadow-blue-500/30 hover:text-blue-300 text-blue-400" },
  { name: "Python", icon: "🐍", color: "hover:border-yellow-400 hover:shadow-yellow-400/30 hover:text-yellow-200 text-yellow-300" },
  { name: "REST APIs", icon: "⚡", color: "hover:border-amber-400 hover:shadow-amber-400/30 hover:text-amber-200 text-amber-300" },
  { name: "Chart.js", icon: "📊", color: "hover:border-rose-500 hover:shadow-rose-500/30 hover:text-rose-200 text-rose-400" },
];
---

<section id="toolkit" class="relative z-10 overflow-hidden bg-neutral-950 px-6 py-20 text-neutral-50">
  <!-- Subtle background accent grid -->
  <div class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <div class="mb-8 max-w-xl">
      <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Toolkit</h2>
      <p class="mt-2 text-xs text-neutral-400 sm:text-sm">
        The stack behind the projects above — chosen for reliability and high performance.
      </p>
    </div>

    <!-- Compact Floating Pill Grid -->
    <div class="flex flex-wrap gap-3">
      {skills.map((skill) => (
        <div
          data-toolkit-pill
          class={`group relative flex items-center gap-3 rounded-xl border border-neutral-800/80 bg-neutral-900/40 px-4 py-2.5 backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-105 hover:bg-neutral-900/90 hover:shadow-lg ${skill.color} cursor-pointer select-none`}
        >
          <!-- Dynamic Cursor Spotlight Glow -->
          <div
            class="pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            style="background-image: radial-gradient(120px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.12), transparent 80%);"
          ></div>

          <!-- Icon Badge with Inner Micro-Glow -->
          <span class="relative flex h-7 w-7 items-center justify-center rounded-lg border border-neutral-700/50 bg-neutral-950/60 text-base transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
            {skill.icon}
          </span>

          <!-- Tech Name -->
          <span class="relative text-xs font-medium tracking-wide text-neutral-300 transition-colors duration-200 group-hover:text-white sm:text-sm">
            {skill.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Mouse-tracking cursor spotlight inside each pill
  document.querySelectorAll("[data-toolkit-pill]").forEach((pill) => {
    pill.addEventListener("pointermove", (e) => {
      const rect = pill.getBoundingClientRect();
      const x = (e as MouseEvent).clientX - rect.left;
      const y = (e as MouseEvent).clientY - rect.top;
      (pill as HTMLElement).style.setProperty("--mx", `${x}px`);
      (pill as HTMLElement).style.setProperty("--my", `${y}px`);
    });
  });
</script>