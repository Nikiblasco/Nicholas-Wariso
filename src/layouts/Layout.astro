---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "Your Name — Software for Independent Hotels" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-900 font-sans antialiased">
    <slot />
  </body>
</html>